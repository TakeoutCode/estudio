{
  "name": "estudio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && pnpm lint:copy",
    "lint:copy": "tsx tools/lint-copy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @estudio/api db:migrate",
    "db:generate": "pnpm --filter @estudio/api db:generate",
    "db:deploy": "pnpm --filter @estudio/api db:deploy",
    "db:seed": "pnpm --filter @estudio/api db:seed"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
