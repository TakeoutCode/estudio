# función de la api ya empaquetada, vieja (ver apps/api/scripts/vercel-build.sh).
node_modules/
dist/
apps/api/vercel-function/
dev-dist/
coverage/
.turbo/
*.tsbuildinfo

.env
.env.*
!.env.example

apps/api/src/generated/

playwright-report/
test-results/

.vercel/
.neon
