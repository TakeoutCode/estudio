{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": { "dependsOn": ["^build", "db:generate"] },
    "dev": { "dependsOn": ["^build", "db:generate"] },
    "typecheck": { "dependsOn": ["^build", "db:generate"] },
