// Esquema de la API. Las entidades sincronizables siguen BACKEND.md BE8 y SYNC.md §1:
// columnas id/user_id/hlc/updated_at/deleted_at/server_seq e índice (user_id, server_seq).
// Lo que Prisma no modela (secuencia sync_seq, triggers de solo inserción) va en el SQL
// de las migraciones. Entre entidades sincronizables no hay FK (BE8): solo hacia "user".

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @db.Uuid
  email            String   @unique
  passwordHash     String   @map("password_hash")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// SYNC §6: cursores menores a este valor reciben 410 cursor_expired.
  purgedThroughSeq BigInt   @default(0) @map("purged_through_seq")

  refreshTokens          RefreshToken[]
  appliedMutations       AppliedMutation[]
  decks                  Deck[]
  topics                 Topic[]
  tags                   Tag[]
  exams                  Exam[]
  notes                  Note[]
  cards                  Card[]
  contrastGroups         ContrastGroup[]
  mediaAssets            MediaAsset[]
  userSettings           UserSettings[]
  selfExplanations       SelfExplanation[]
  studySessions          StudySession[]
  reviewLogs             ReviewLog[]
  timerSessions          TimerSession[]
  timerBlockLogs         TimerBlockLog[]
  sleepLogs              SleepLog[]
  rewards                Reward[]
  rewardRedemptions      RewardRedemption[]
  aiDrafts               AiDraft[]
  aiUsage                AiUsage[]
  aiFeedback             AiFeedback[]
  pushSubscriptions      PushSubscription[]
  notificationEvents     NotificationEvent[]
  scheduledNotifications ScheduledNotification[]
  notificationState      NotificationState?

  @@map("user")
}

/// BACKEND BE10: refresh opaco guardado como SHA-256, rotado en cada uso. Una familia es
/// la sesión de un dispositivo; reutilizar un token ya rotado la revoca completa.
model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_token")
}

/// SYNC §3: registro de mutaciones aplicadas para responder `duplicate`. Se purga a los 30 días.
model AppliedMutation {
  userId     String   @map("user_id") @db.Uuid
  mutationId String   @map("mutation_id") @db.Uuid
  appliedAt  DateTime @default(now()) @map("applied_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, mutationId])
  @@map("applied_mutation")
}

model Deck {
  id          String  @id @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String
  description String?
  pausedAt    BigInt? @map("paused_at") // diseño: en pausa, fuera de Hoy y de los recordatorios
  hlc         String
  updatedAt   BigInt  @map("updated_at")
  deletedAt   BigInt? @map("deleted_at")
  serverSeq   BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("deck")
}

/// LEARNING-DESIGN LD5, STUDY-METHODS R5: tema de un mazo con la explicación del concepto.
model Topic {
  id          String  @id @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  deckId      String  @map("deck_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  name        String
  explanation String
  hlc         String
  updatedAt   BigInt  @map("updated_at")
  deletedAt   BigInt? @map("deleted_at")
  serverSeq   BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, deckId])
  @@map("topic")
}

/// LEARNING-DESIGN §1, §6 (diseño): etiqueta de ella, entre mazos; las notas la referencian en
/// `note.tag_ids`.
model Tag {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("tag")
}

/// STUDY-METHODS R11, LEARNING-DESIGN LD11: examen con su fecha y los temas que entran.
model Exam {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  title     String
  date      BigInt // inicio del día del examen en su zona (AG6)
  topicIds  Json    @map("topic_ids") // uuid[] como JSON; cada uno lo valida el handler (BE2)
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("exam")
}

/// STUDY-METHODS P7, LEARNING-DESIGN LD13: simulacro (mode 'exam') con sus preguntas y respuestas.
model StudySession {
  id             String  @id @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  mode           String
  examId         String  @map("exam_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  feedbackTiming String  @map("feedback_timing")
  items          Json // preguntas con confianza, respuesta y calificación; cada cardId lo valida el handler
  startedAt      BigInt  @map("started_at")
  finishedAt     BigInt? @map("finished_at")
  hlc            String
  updatedAt      BigInt  @map("updated_at")
  deletedAt      BigInt? @map("deleted_at")
  serverSeq      BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, examId])
  @@map("study_session")
}

/// LD5: "Explícalo con tus palabras" antes de la primera tarjeta nueva de un tema. No es un repaso.
model SelfExplanation {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  topicId   String  @map("topic_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  kind      String  @default("self") // 'self' (LD5) | 'teach' ("Explícaselo a alguien")
  text      String
  gaps      String?
  writtenAt BigInt  @map("written_at")
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, topicId])
  @@map("self_explanation")
}

/// LEARNING-DESIGN §1: el contenido que ella crea. `kind` repite `content.kind` para filtrar.
model Note {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  deckId    String  @map("deck_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  topicId   String? @map("topic_id") @db.Uuid
  kind      String
  content   Json
  origin    String
  tagIds    Json    @default("[]") @map("tag_ids") // uuid[] como JSON; cada una la valida el handler (BE2)
  mnemonic  String? // R14: andamio opcional que ella escribe tras entender
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, deckId])
  @@map("note")
}

/// Lo que programa FSRS: un lado o hueco de una nota. Id = uuidv5(noteId, ordinal) (SYNC §1).
/// Su estado FSRS no se guarda aquí: es la proyección de su ReviewLog (ARC5).
model Card {
  id            String  @id @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  noteId        String  @map("note_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  ordinal       Int
  createdAt     BigInt  @map("created_at")
  lapseBaseline Int     @map("lapse_baseline")
  hlc           String
  updatedAt     BigInt  @map("updated_at")
  deletedAt     BigInt? @map("deleted_at")
  serverSeq     BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, noteId])
  @@map("card")
}

/// STUDY-METHODS R9, P4; LEARNING-DESIGN LD10: notas que se confunden. El brazo del A/B se sortea
/// al crearse y no cambia.
model ContrastGroup {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  noteIds   Json    @map("note_ids") // uuid[] como JSON; cada una la valida el handler (BE2)
  abSeed    BigInt  @map("ab_seed")
  abArm     String  @map("ab_arm")
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("contrast_group")
}

/// FRONTEND §5, ADR-010: imagen que el cliente sube directo a Cloudinary con una firma de la API.
/// `public_id` y `version` quedan en null hasta que termina la subida (FE8).
model MediaAsset {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  kind      String
  mime      String
  bytes     Int
  width     Int
  height    Int
  publicId  String? @map("public_id") // estudio/<userId>/<id> (QUALITY §6)
  version   BigInt?
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("media_asset")
}

/// SYNC §1: una fila por sección con id = uuidv5(userId, sección).
model UserSettings {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  section   String
  data      Json
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, section])
  @@index([userId, serverSeq])
  @@map("user_settings")
}

/// STUDY-METHODS §3, SYNC SY7: estado de la máquina de `srs/timer`. Una sola sesión activa por
/// cuenta (ADR-006): el handler cierra las demás como `superseded`.
model TimerSession {
  id                String  @id @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  state             String
  mode              String
  startedAt         BigInt? @map("started_at")
  pausedAt          BigInt? @map("paused_at")
  pausedMs          BigInt  @map("paused_ms")
  blockIndex        Int     @map("block_index")
  completedBlocks   Int     @map("completed_blocks")
  plannedMs         BigInt  @map("planned_ms")
  extendedThisBlock Boolean @map("extended_this_block")
  ownerDeviceId     String  @map("owner_device_id") @db.Uuid
  lastSeenAt        BigInt? @map("last_seen_at")
  endedReason       String? @map("ended_reason")
  hlc               String
  updatedAt         BigInt  @map("updated_at")
  deletedAt         BigInt? @map("deleted_at")
  serverSeq         BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, state])
  @@map("timer_session")
}

/// §3, P6: cada bloque o descanso cerrado. Solo inserción (trigger timer_block_log_append_only).
model TimerBlockLog {
  id             String  @id @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  timerSessionId String  @map("timer_session_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  deviceId       String  @map("device_id") @db.Uuid
  kind           String
  blockIndex     Int     @map("block_index")
  mode           String
  startedAt      BigInt  @map("started_at")
  endedAt        BigInt  @map("ended_at")
  plannedMs      BigInt  @map("planned_ms")
  activeMs       BigInt  @map("active_ms")
  outcome        String
  extended       Boolean @default(false) // §5: el bloque usó "+N min"
  serverSeq      BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, timerSessionId])
  @@map("timer_block_log")
}

/// STUDY-METHODS §5: calidad de una noche (1-5), opcional y sin gamificar. Una fila por noche:
/// id = uuidv5(userId, date) (SYNC §1). No entra en FSRS ni en los avisos.
model SleepLog {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  date      String // YYYY-MM-DD, día local de ella en que terminó la noche (AG6)
  quality   Int     @db.SmallInt
  loggedAt  BigInt  @map("logged_at")
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("sleep_log")
}

/// UX10 (diseño · sin evidencia): un premio de la tienda, con el nombre y el costo que ella
/// define. LWW. El saldo de monedas no se guarda: se calcula con srs (SYNC §1).
model Reward {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  name      String
  cost      Int
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("reward")
}

/// UX10: un canje, con la foto del nombre y el costo. Solo inserción (trigger
/// reward_redemption_append_only en la migración).
model RewardRedemption {
  id         String @id @db.Uuid
  userId     String @map("user_id") @db.Uuid
  rewardId   String @map("reward_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  name       String
  cost       Int
  redeemedAt BigInt @map("redeemed_at")
  deviceId   String @map("device_id") @db.Uuid
  serverSeq  BigInt @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("reward_redemption")
}

/// LEARNING-DESIGN LD16: un borrador de nota generado por la IA, que ella revisa (LWW). Aceptarlo
/// crea la nota con origin 'ai' y guarda su id.
model AiDraft {
  id        String  @id @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  kind      String
  deckId    String  @map("deck_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  draft     Json
  supported Boolean
  edited    Boolean
  status    String
  noteId    String? @map("note_id") @db.Uuid
  createdAt BigInt  @map("created_at")
  hlc       String
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("ai_draft")
}

/// LD14: la retroalimentación de IA que ella pidió para una respuesta abierta. Solo inserción
/// (trigger ai_feedback_append_only en la migración); sin nota numérica.
model AiFeedback {
  id          String @id @db.Uuid
  userId      String @map("user_id") @db.Uuid
  cardId      String @map("card_id") @db.Uuid // sin FK: lo valida el handler (BE2)
  requestedAt BigInt @map("requested_at")
  feedback    Json
  serverSeq   BigInt @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@map("ai_feedback")
}

/// LD17 y BE6: un intento con la IA, para la cuota diaria y la revisión de costos. Nunca guarda
/// el texto de ella ni lo que respondió el modelo. Solo servidor (no se sincroniza).
model AiUsage {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  localDate    String   @map("local_date") // YYYY-MM-DD, día local de ella (AG6)
  task         String
  attempt      Int      @db.SmallInt
  model        String
  status       String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  latencyMs    Int      @map("latency_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, localDate])
  @@map("ai_usage")
}

/// R3: solo inserción (trigger review_log_append_only en la migración).
model ReviewLog {
  id         String @id @db.Uuid
  userId     String @map("user_id") @db.Uuid
  cardId     String @map("card_id") @db.Uuid
  cardKind   String @map("card_kind")
  reviewedAt BigInt @map("reviewed_at")
  rating     Int    @db.SmallInt
  durationMs Int    @map("duration_ms")
  type       String
  confidence Int?   @db.SmallInt
  sessionId  String @map("session_id") @db.Uuid
  deviceId   String @map("device_id") @db.Uuid
  answer     Json?
  serverSeq  BigInt @map("server_seq") // nextval('sync_seq') explícito en cada escritura (SYNC §3)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, serverSeq])
  @@index([userId, cardId])
  @@map("review_log")
}

/// NOTIFICATIONS §2: suscripción Web Push de un dispositivo (solo servidor, no se sincroniza).
model PushSubscription {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String    @map("device_id") @db.Uuid
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(3)
  failures      Int       @default(0)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

/// NOTIFICATIONS §2, NT5: un recordatorio agrupado por usuario y día local, enviado o suprimido
/// con su motivo (§6: para revisar la política con datos). La unicidad (usuario, día) hace que
/// dos ticks concurrentes no dupliquen (NT-T6).
model NotificationEvent {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  kinds         String[]
  localDate     String   @map("local_date")
  scheduledFor  BigInt   @map("scheduled_for")
  sentAt        BigInt?  @map("sent_at")
  openedAt      BigInt?  @map("opened_at")
  status        String // pending | sent | failed | suppressed
  reason        String?
  payloadKey    String?  @map("payload_key")
  payloadParams Json?    @map("payload_params")
  /// NT-T11: "examId:N" avisados en este evento.
  examDays      String[] @map("exam_days")
  /// §3d: 1 = a la hora del recordatorio (`dailyReminderTime`), 2 = a la segunda hora.
  slot          Int      @default(1)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate, slot])
  @@map("notification_event")
}

/// NT4: fin de descanso programado por el cliente; se envía una sola vez por bloque.
model ScheduledNotification {
  id             String  @id @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  timerSessionId String  @map("timer_session_id") @db.Uuid
  blockIndex     Int     @map("block_index")
  fireAt         BigInt  @map("fire_at")
  cancelledAt    BigInt? @map("cancelled_at")
  sentAt         BigInt? @map("sent_at")
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([timerSessionId, blockIndex])
  @@index([fireAt])
  @@map("scheduled_notification")
}

/// NT7, §3f: "Como antes" reinicia la serie de ignorados; la pregunta se hace una sola vez.
model NotificationState {
  userId                    String  @id @map("user_id") @db.Uuid
  backoffResetAt            BigInt? @map("backoff_reset_at")
  backoffQuestionAnsweredAt BigInt? @map("backoff_question_answered_at")
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_state")
}
