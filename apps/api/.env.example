# Copia a .env para desarrollo local. Cada variable nueva va también en src/config/env.ts (BE4).
NODE_ENV=development
PORT=3180
LOG_LEVEL=debug
# App: URL con pooler de Neon. Migraciones (prisma.config.ts): URL directa.
DATABASE_URL=postgresql://estudio:estudio@localhost:5433/estudio
DIRECT_DATABASE_URL=postgresql://estudio:estudio@localhost:5433/estudio
# Orígenes exactos de la web, separados por coma (CORS y CSRF). En producción: https://app.<dominio>
WEB_ORIGINS=http://localhost:5180
# Proxies delante de la API que agregan X-Forwarded-For (BE12): 0 en local, 1 en Railway. Sin esto,
# detrás de un proxy todas las peticiones compartirían el límite por IP del login.
TRUST_PROXY_HOPS=0
# Contrato mínimo aceptado (ARC6), además de MIN_SAFE_CONTRACT de shared (que cubre los campos LWW
# nuevos). Súbelo solo cuando otro cambio rompa la compatibilidad, p. ej. una ruta HTTP.
MIN_CONTRACT=1
# Secreto del access JWT (BE10): 32 caracteres o más, distinto por entorno.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=REEMPLAZAR
# Solo estos correos pueden registrarse (ADR-007), separados por coma.
ALLOWED_EMAILS=estudiante@ejemplo.com
# Solo `pnpm db:seed` (prisma/seed.ts); no va en env.ts. Cuenta ya registrada que recibe el mazo
# de desarrollo. Sin ella, el seeder usa el primer correo de ALLOWED_EMAILS.
# SEED_EMAIL=estudiante@ejemplo.com
# Web Push (NOTIFICATIONS NT8). Obligatorias en producción; sin ellas, en desarrollo los avisos
# se registran sin enviarse. Genera el par con: npx web-push generate-vapid-keys
# La pública va también en apps/web/.env como VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:avisos@ejemplo.com
# Imágenes (ADR-010): cloudinary://<api_key>:<api_secret>@<cloud_name>, del panel de Cloudinary.
# Obligatoria en producción; sin ella, en desarrollo las imágenes se ven solo en el dispositivo
# que las agregó. El cloud_name va también en apps/web/.env como VITE_CLOUDINARY_CLOUD_NAME.
CLOUDINARY_URL=
# Monitor de disponibilidad (QUALITY QA8): secreto de 32 caracteres o más para GET /health/checks/:token.
# Obligatorio en producción; en desarrollo puede quedar vacío (la ruta responde 404).
HEALTH_CHECK_TOKEN=
# IA opcional (LEARNING-DESIGN §8, ADR-011): clave y modelo van juntos; sin ellos, /ai/* responde 503
# y la app sigue con la captura manual. Cuota diaria por usuario (LD17).
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_REQUESTS=30
AI_DAILY_TOKENS=200000
