{
  "name": "@estudio/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@estudio/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
